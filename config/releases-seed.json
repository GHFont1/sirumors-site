{
  "_note": "Well-documented historical releases used before official feeds cover them, and for labs with no feed. New releases are detected automatically from official feeds (first official mention) and news coverage.",
  "lines": [
    {
      "id": "openai-gpt",
      "name": "OpenAI GPT",
      "company": "openai",
      "kind": "model",
      "detect": {
        "sources": [
          "openai"
        ],
        "pattern": "\\bGPT[-\u2011 ]?(\\d+(?:\\.\\d+)?)(o)?\\b",
        "min": 4,
        "newsFallback": true,
        "backfill": "OpenAI GPT (launches OR releases OR introduces)"
      }
    },
    {
      "id": "openai-reasoning",
      "name": "OpenAI o-series",
      "company": "openai",
      "kind": "model",
      "retired": "Folded into GPT-5 (August 2025); OpenAI now ships reasoning inside the GPT line."
    },
